<form
  class="popup__form form js-cm-form"
  action="https://www.createsend.com/t/subscribeerror?description="
  data-id="30FEA77E7D0A9B8D7616376B900632314FFBEDB3B2256314BC8929C64386664959147DC81A749C73E08FADB840F771CB1DC2C05A170A6E865B35ABBBD38F9A7E"
  method="post"
>
  <input name="id" type="hidden" value="Urban Myth Style Download" />
  <label class="form__label">
    <input
      type="text"
      name="cm-name"
      class="form__input"
      placeholder="Name"
      maxlength="200"
      required
    />
  </label>
  <label class="form__label">
    <input
      type="email"
      name="cm-jtikhyh-jtikhyh"
      class="form__input _req js-cm-email-input qa-input-email"
      placeholder="Email"
      maxlength="200"
      autocomplete="email"
      required
    />
  </label>
  <label class="form__label">
    <input
      class="form__input"
      aria-label="Postcode"
      placeholder="Postcode"
      id="fieldddijlih"
      maxlength="200"
      name="cm-f-ddijlih"
      required
    />
  </label>

  <label class="form__label">
    <input
      class="form__input"
      aria-label="Telephone"
      placeholder="Telephone"
      id="fieldddijlid"
      maxlength="200"
      name="cm-f-ddijlid"
      required
    />
  </label>

  <label class="form__label form__label_select">
    <select class="_select" id="fieldddijlij" name="cm-fo-ddijlij" required>
      <option selected="" value="" disabled hidden>I am starting my project...</option>
      <option value="2286477">In the next few weeks</option>
      <option value="2286478">In the next 6 months</option>
      <option value="2286479">Just researching the market</option>
    </select>
  </label>

  <label class="form__label form__label_select">
    <select class="_select" id="fieldddijlit" name="cm-fo-ddijlit" required>
      <option selected="" value="" disabled hidden>My budget is...</option>
      <option value="2286480">£20-£30k</option>
      <option value="2286481">£30-£40k</option>
      <option value="2286482">£40k+</option>
      <option value="2286483">I don't know</option>
    </select>
  </label>

  <div class="form__privacy">
    <label class="form__label-privacy">
      <input
        type="checkbox"
        name="cm-fo-ddijliy"
        class="form__input-checkbox"
        value="2286476"
        required
      />
      <span>
        I have read and accept the Urban Myth
        <a href="[[~22]]" target="_blank">Privacy Policy</a>
      </span>
    </label>
  </div>
  <input
    aria-label="campaignID"
    id="fieldddijlii"
    name="cm-f-ddijlii"
    type="hidden"
    class="marketing_source"
    value="[[*campaign-id]]"
  />
  <input
    aria-label="Date Added"
    id="fieldddijlik"
    name="cm-fd-ddijlik"
    type="hidden"
  />
  <button type="submit" class="form__submit button js-cm-submit-button">
    download
  </button>
</form>
